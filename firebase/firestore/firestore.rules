// Contributors: OpenAI Codex (GPT-6.2 Sol, high; #447 under Lucas Pinto Ricardo’s supervision and approval).
// Contributors: OpenAI Codex (GPT-6.2 Sol, high; #446 under Lucas Pinto Ricardo’s supervision and approval).
// Contributors: OpenAI Codex (deleted-token chat access, #241).
// Contributors: Claude (isEpflUser helper, #33; own users/{uid} rule and no catch-all, #35;
// fixed uid and accountType after review, #35; @epfl.ch associations aren't students and
// accountType values on create, association profiles not deletable by the client, #161;
// associations/{uid}, #126; displayName limit, written test-first, #143; publicProfiles/{uid},
// written test-first, #229; reads by ID only and fixed section and year lists, after review, #229;
// deleted accounts stay deleted and private edits keep the public copy, after review, #229;
// interests from the fixed list, written test-first, #230);
// OpenAI Codex (public/private event read rules, #52); Claude (Sonnet 5.5, Anthropic) (events
// restricted to sections, written test-first, #369); Claude Opus 5.5 (event write rules, #47;
// badge and locationName checks after review; isStudent for writes after #161; organizers
// stay allowed readers after review; event registrations, #121; deleted accounts can't
// register, #275); Claude (Opus 5.5, Anthropic) (event groups and their groupMembers markers,
// #232, with fixes after review; group chat messages, #237, and no messages from a deleted
// account, after review); Claude Opus 5.5 (friendships, written test-first and adapted from
// Mohamed Khellaf's #365 prototype, #357, and no association in a request after Lucas Pinto
// Ricardo's review; Konstantinos Perdikeas directed, reviewed and owns it).
rules_version = '2';
// Contributors: OpenAI Codex (prevent deleted tokens recreating group membership, #241).
// Contributors: Claude (Opus 5.5, Anthropic) (co-organizers, written test-first, #370).
// Contributors: Claude (Opus 5.5, Anthropic) (attendeeCount, from #372's sketch and prototype by
// Claude (Fable 5.2 and Opus 5.5, Anthropic), #373).
// Contributors: Claude (Opus 5.5, Anthropic) (the message check shared by both chats, and
// one-to-one chats, from #365's prototype by Claude (Fable 5.2 and Opus 5.5, Anthropic), #428).
// Contributors: Claude (Opus 5.5, Anthropic) (usernames and their tie to the profiles, #448).
// Contributors: Claude (Opus 5.5, Anthropic) (check-ins at the venue and the shared event() and canReadEvent(), #467).
// Contributors: Claude (Opus 5.5, Anthropic) (the entrance code and QR check-ins, #468).

service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified email address (a student or an association).
    function hasVerifiedEmail() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Signed in with a verified @epfl.ch email address.
    function isEpflUser() {
      return hasVerifiedEmail()
          && request.auth.token.email.matches('[^@]+@epfl[.]ch');
    }

    // A student: a verified @epfl.ch account whose profile isn't an association's. An association
    // can have an @epfl.ch email too, and then gets only association access (#161). Only a
    // profile with accountType "association" removes student access: a student has no profile
    // yet during the profile step, accountType is "student" or "association" when present, and
    // it can't change once the profile exists.
    function isStudent() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return isEpflUser()
          && !(exists(profile) && get(profile).data.get('accountType', 'student') == 'association');
    }

    // The sections the app offers: keep them equal to SECTIONS in
    // app/src/main/java/com/polysocial/model/user/ProfileOptions.kt. The rules tests read that file
    // and fail if a code it offers is refused here. Public profiles and events (#369) use it.
    function isKnownSection(section) {
      return section in ['AR', 'CGC', 'CMS', 'EL', 'GC', 'GM', 'IF', 'IN', 'MA', 'MT', 'MTE',
          'MX', 'NX', 'PH', 'SC', 'SIE', 'SIQ', 'SV'];
    }

    // The signed-in student's section, from their public profile. Without one the get fails, and
    // an event restricted to sections stays closed to them (#369).
    function mySection() {
      return get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.section;
    }

    // Whether an event's section restriction lets in the signed-in student: it is open to every
    // section (allowedSections == []) or lists theirs (#369). `data` is the event's fields. There
    // is deliberately no default for a missing allowedSections (no data.get(...)) and no test of
    // the field's absence: a list query is accepted when the rule holds for what the query
    // constrains, and either of those holds for a query that doesn't mention allowedSections, so
    // it would return events restricted to other sections (shown in the rules tests). An event
    // without the field is closed until backfillAllowedSections.js sets it.
    function sectionsOpenTo(data) {
      return data.allowedSections == [] || mySection() in data.allowedSections;
    }

    // Whether deleteAccount deleted this account: it writes deletedAccounts/{uid} in the transaction
    // that deletes both profiles (#229 review). The deleted user's ID token stays valid until it
    // expires, so without it another of their devices could recreate the profiles afterwards, and
    // other students could read the public one; it could also still send messages to its groups
    // (#237). Firebase never reuses a UID. The app can't read or write deletedAccounts: no rule
    // matches it.
    function isDeletedAccount(uid) {
      return exists(/databases/$(database)/documents/deletedAccounts/$(uid));
    }

    // An ID of exactly two non-empty parts joined by one '~'. split('~') drops trailing empty parts
    // ("u1~u2~" splits as "u1~u2" does), so the ID is also compared with its two parts joined
    // again. Shared by friendships (#357) and one-to-one chats (#428).
    function isTwoPartId(id) {
      let parts = id.split('~');
      return parts.size() == 2
          && parts[0] != ''
          && id == parts[0] + '~' + parts[1];
    }

    // The pair ID of #338 for member: two different UIDs, sorted, one of them member's.
    function isPairIdOf(id, member) {
      let pair = id.split('~');
      return isTwoPartId(id)
          && pair[0] < pair[1]
          && pair.hasAny([member]);
    }

    // Read the current friendship. A batch that accepts a request cannot also send a chat
    // message, and one that removes a friend can still send a last message.
    function isAcceptedFriendship(pairId) {
      let friendship = /databases/$(database)/documents/friendships/$(pairId);
      return exists(friendship) && get(friendship).data.get('status', null) == 'accepted';
    }

    // A chat message as the caller sends it, in a group's chat (#237) or a one-to-one chat (#428):
    // exactly senderId (the caller's UID), text (1 to 1000 characters, counted like the app's
    // MAX_MESSAGE_LENGTH) and the server's createdAt.
    function isNewMessage() {
      return request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
    }

    // The interest codes the app offers (#230): keep them equal to INTERESTS in
    // app/src/main/java/com/polysocial/model/user/ProfileOptions.kt. The rules tests read that file
    // and fail if the two lists differ.
    function interestCodes() {
      return ['sports', 'outdoors', 'music', 'parties', 'cinema', 'games', 'photography',
          'cooking', 'tech', 'startups', 'arts', 'volunteering'];
    }

    // No interests (a profile saved before #230), or a list of known codes, each at most once, so
    // at most one of each. An association's profile holds an empty list: it gets no matching.
    function hasKnownInterests(data) {
      return !('interests' in data)
          || (data.interests is list
              && data.interests.hasOnly(interestCodes())
              && data.interests.toSet().size() == data.interests.size());
    }

    // Student profile details (#446). Missing visibility is private, and a missing bio is valid.
    function hasValidProfileDetails(data) {
      return data.get('profileVisibility', 'private') in ['public', 'private']
          && (!('bio' in data)
              || (data.bio is string && data.bio.size() >= 1 && data.bio.size() <= 150));
    }

    function copiesProfileDetails(data, owner) {
      return data.get('profileVisibility', 'private') == owner.get('profileVisibility', 'private')
          && data.get('bio', null) == owner.get('bio', null);
    }

    // Each account's private profile. Open to any verified email (most associations have no
    // EPFL email); besides it, an unverified association reaches only its own
    // associations/{uid} (#126).
    // Only an admin sets isAssociationVerified, in the Firebase console. The uid field names
    // the document's owner, and uid and accountType are fixed once created, so an admin
    // verifying an account isn't misled. An association can't delete its own profile: without
    // it, an @epfl.ch association would count as a student again (#161). An admin deletes
    // association accounts instead.
    match /users/{uid} {
      function isOwner() {
        return hasVerifiedEmail() && request.auth.uid == uid;
      }

      // The full name's limit (#143): a displayName, when present, is a string of at most 50
      // characters (the app's MAX_DISPLAY_NAME_LENGTH). size() counts UTF-16 units, as the app does.
      function hasValidDisplayName() {
        return !('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50);
      }

      // A student setting either field needs the matching public copy after this write.
      function hasMirroredStudentDetails() {
        let data = request.resource.data;
        return !data.keys().hasAny(['profileVisibility', 'bio'])
            || (isEpflUser() && data.get('accountType', 'student') == 'student'
                && hasValidProfileDetails(data)
                && copiesProfileDetails(
                    data, getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data));
      }

      // Once a public profile exists, a change to a field it copies must update it in the same
      // write, so other students never see stale values (#229 review). A profile saved before #229
      // has no public copy yet, and an association never gets one: neither needs it. Removing a
      // copied field fails the comparison too.
      function keepsPublicProfile() {
        let copied = ['displayName', 'section', 'year', 'interests', 'username',
            'profileVisibility', 'bio'];
        let publicProfile = /databases/$(database)/documents/publicProfiles/$(uid);
        let data = request.resource.data;
        return !data.diff(resource.data).affectedKeys().hasAny(copied)
            || !exists(publicProfile)
            || (getAfter(publicProfile).data.displayName == data.get('displayName', null)
                && getAfter(publicProfile).data.section == data.get('section', null)
                && getAfter(publicProfile).data.year == data.get('year', null)
                && getAfter(publicProfile).data.interests == data.get('interests', [])
                && getAfter(publicProfile).data.get('username', null)
                    == data.get('username', null)
                && copiesProfileDetails(getAfter(publicProfile).data, data));
      }

      function usernameDocument(name) {
        return /databases/$(database)/documents/usernames/$(name);
      }

      // A username (#448) is tied to its usernames/{name} both ways, so nobody keeps two names or
      // names one they don't hold: a write that changes or removes username must free the old name
      // in the same write (#445 review), and one that sets a name must hold it after the write
      // (claimed in the same write, see usernames/{name}).
      function keepsUsername() {
        let before = resource.data.get('username', null);
        let after = request.resource.data.get('username', null);
        return before == after
            || ((before == null || !existsAfter(usernameDocument(before)))
                && (after == null
                    || (after is string
                        && existsAfter(usernameDocument(after))
                        && getAfter(usernameDocument(after)).data.uid == uid)));
      }

      allow read: if isOwner();
      // A profile that names a username frees it in the same write (#448), so a deleted profile
      // can't leave a name reserved. While its public copy exists, which no client deletes and
      // which holds the same username, it can't be deleted at all: the freed name could otherwise
      // be claimed by someone else and show on two public profiles (#517 review).
      allow delete: if isOwner()
          && (resource == null || resource.data.get('accountType', 'student') != 'association')
          && (resource == null
              || resource.data.get('username', null) == null
              || (!existsAfter(usernameDocument(resource.data.username))
                  && !existsAfter(/databases/$(database)/documents/publicProfiles/$(uid))));
      allow create: if isOwner()
          && !isDeletedAccount(uid)
          && request.resource.data.uid == uid
          && (!('accountType' in request.resource.data)
              || request.resource.data.accountType in ['student', 'association'])
          && (!('isAssociationVerified' in request.resource.data)
              || request.resource.data.isAssociationVerified == false)
          && hasValidDisplayName()
          && hasKnownInterests(request.resource.data)
          && hasMirroredStudentDetails()
          // A username is claimed once the profile exists (#448).
          && !('username' in request.resource.data);
      allow update: if isOwner()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['uid', 'accountType', 'isAssociationVerified'])
          && hasValidDisplayName()
          && hasKnownInterests(request.resource.data)
          && hasMirroredStudentDetails()
          && keepsPublicProfile()
          && keepsUsername();
    }

    // What other students see of a student (#229): exactly displayName, section, year and
    // interests, plus username (#448), visibility and bio when set (#446), never the email.
    // Any student reads one by UID, to match with and show group members. Only a student owner
    // writes it. List queries and association reads are denied, so there is no student directory.
    // The public copy must match users/{uid} after the same write (getAfter), so it is
    // written with the private profile and can't say anything else. Because others read them, section and year must be codes the app offers.
    // users/{uid} can't change a copied field without it (keepsPublicProfile), and a deleted
    // account can't write it again (isDeletedAccount).
    // interests are codes from the fixed list (#230), in the private profile's order; a private
    // profile saved before #230 has none, so its copy has []. Nobody deletes it from the app:
    // deleteAccount removes it with the account (a client deleting users/{uid} directly, which the
    // app never does, would leave it behind until then). Each copied field is compared, so a
    // missing one, or a missing users/{uid}, makes the rule fail and deny.
    match /publicProfiles/{uid} {
      // The years the app offers: keep them equal to YEARS in
      // app/src/main/java/com/polysocial/model/user/ProfileOptions.kt, like isKnownSection above.

      function isKnownYear(year) {
        return year in ['BA1', 'BA2', 'BA3', 'BA4', 'BA5', 'BA6', 'MA1', 'MA2', 'MA3', 'MA4'];
      }

      function privateProfileAfter() {
        return getAfter(/databases/$(database)/documents/users/$(uid));
      }

      function copiesPrivateProfile() {
        let data = request.resource.data;
        let fields = ['displayName', 'section', 'year', 'interests', 'username',
            'profileVisibility', 'bio'];
        let owner = privateProfileAfter().data;
        return data.keys().hasOnly(fields)
            && owner.get('accountType', 'student') == 'student'
            && data.displayName == owner.displayName
            && data.section == owner.section
            && data.year == owner.year
            && isKnownSection(data.section)
            && isKnownYear(data.year)
            && data.interests == owner.get('interests', [])
            && hasKnownInterests(data)
            && data.get('username', null) == owner.get('username', null)
            && hasValidProfileDetails(data)
            && copiesProfileDetails(data, owner);
      }

      allow get: if isStudent();
      allow create, update: if isStudent()
          && request.auth.uid == uid
          && !isDeletedAccount(uid)
          && copiesPrivateProfile();

      // The profile owner is fixed by the path, so a query needs no filter. Check the live
      // friendship for access to a private list even if the trigger has yet to remove its rows.
      match /friends/{friendUid} {
        function ownerIsPublic() {
          let owner = /databases/$(database)/documents/publicProfiles/$(uid);
          return exists(owner) && get(owner).data.get('profileVisibility', 'private') == 'public';
        }

        function isAcceptedFriend() {
          let viewer = request.auth.uid;
          let pair = viewer < uid ? viewer + '~' + uid : uid + '~' + viewer;
          return isAcceptedFriendship(pair);
        }

        allow get, list: if isStudent()
            && !isDeletedAccount(request.auth.uid)
            && !isDeletedAccount(uid)
            && (request.auth.uid == uid || ownerIsPublic() || isAcceptedFriend());
        // Only syncFriendLists writes entries through the Admin SDK.
      }
    }

    // Usernames (#448, decided in #366): usernames/{name} holds the uid of the student whose
    // users/{uid}.username names it, so the ID makes each name unique. A student gets one name they
    // typed but never lists them, so there is no student directory. A student claims a name only
    // as their own, with their profile naming it after the same write, and frees it only when their
    // profile no longer names it after the write: a rename, a removal or the profile deleted.
    // users/{uid} ties it back (keepsUsername). Nobody updates one; deleteAccount frees a deleted
    // account's name (Admin SDK). The format and the reserved names are Username.kt's: the rules
    // tests read that file and fail if they differ.
    match /usernames/{name} {
      function reservedUsernames() {
        return ['polysocial', 'admin', 'support', 'epfl', 'agepoly', 'staff', 'moderator',
            'official', 'help'];
      }

      function ownProfile() {
        return /databases/$(database)/documents/users/$(request.auth.uid);
      }

      allow get: if isStudent() && !isDeletedAccount(request.auth.uid);
      allow create: if isStudent()
          && !isDeletedAccount(request.auth.uid)
          && name.matches('[a-z][a-z0-9_.]{2,19}')
          && !(name in reservedUsernames())
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && existsAfter(ownProfile())
          && getAfter(ownProfile()).data.get('username', null) == name;
      allow delete: if isStudent()
          && resource.data.uid == request.auth.uid
          && (!existsAfter(ownProfile())
              || getAfter(ownProfile()).data.get('username', null) != name);
    }

    // Of the event subcollections, only attendees (below), groups, their messages and
    // groupMembers (after this block) are reachable. Private queries also need isPrivate == true
    // and allowedUids array-contains auth.uid; public queries need isPrivate == false and, to
    // prove the section restriction (#369), allowedSections == [] or allowedSections
    // array-contains the student's section, joined with OR.
    match /events/{eventId} {
      function isVerifiedAssociationOwner() {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return hasVerifiedEmail()
            && profile.accountType == 'association'
            && profile.isAssociationVerified == true
            && resource.data.isAssociationEvent == true
            && resource.data.createdBy == request.auth.uid;
      }

      // A public event is readable by the students of its sections, and by its organizers
      // whatever their section (#369). A list query must ask for what proves it: see
      // sectionsOpenTo, and EventRepository.getUpcomingPublicEvents.
      allow read: if (isStudent()
          && ((resource.data.isPrivate == false
                  && (sectionsOpenTo(resource.data)
                      || resource.data.organizerIds.hasAny([request.auth.uid])))
              || (resource.data.isPrivate == true
                  && resource.data.allowedUids.hasAny([request.auth.uid]))))
          || (hasVerifiedEmail() && isVerifiedAssociationOwner());

      function callerProfile() {
        return /databases/$(database)/documents/users/$(request.auth.uid);
      }

      // Read from the protected users/{uid}, never from token claims. A student without a
      // profile yet, or whose profile has no accountType, is not an association.
      function isAssociationAccount() {
        return exists(callerProfile())
            && get(callerProfile()).data.get('accountType', null) == 'association';
      }

      function isVerifiedAssociation() {
        return isAssociationAccount()
            && get(callerProfile()).data.get('isAssociationVerified', false) == true;
      }

      // Who may create and manage events: a student (isStudent, the same check as reads), or an
      // association a PolySocial admin has verified. An association account with an @epfl.ch
      // email still needs that verification.
      function canWriteEvents() {
        return hasVerifiedEmail() && (isVerifiedAssociation() || isStudent());
      }

      // The limits of validateNewEvent (title, description), MAX_LOCATION_NAME_LENGTH and the
      // EventCategory names. Events saved before locationName existed don't have it. The
      // creator always stays an organizer, and every organizer is an allowed reader, so no
      // organizer can manage a private event they can't read.
      function isValidEvent(data) {
        return data.title is string
            && data.title.trim().size() > 0
            && data.title.size() <= 80
            && data.description is string
            && data.description.size() <= 5000
            && (!('locationName' in data)
                || (data.locationName is string && data.locationName.size() <= 100))
            && data.category in ['STUDY', 'SPORTS', 'CULTURE', 'PARTY', 'OTHER']
            && data.isPrivate is bool
            && data.isAssociationEvent is bool
            && data.organizerIds is list
            && data.organizerIds.hasAny([data.createdBy])
            && data.allowedUids is list
            && data.allowedUids.hasAll(data.organizerIds)
            && hasValidAllowedSections(data);
      }

      // The sections a public event of a student is open to (#369): a list of distinct codes the
      // app offers, [] for every section. Always present, because the read rule and the list
      // queries rely on it; a private event or an association's has none.
      function hasValidAllowedSections(data) {
        return data.allowedSections is list
            && data.allowedSections.size() <= 18
            && data.allowedSections.toSet().size() == data.allowedSections.size()
            && data.allowedSections.hasOnly(['AR', 'CGC', 'CMS', 'EL', 'GC', 'GM', 'IF', 'IN', 'MA',
                'MT', 'MTE', 'MX', 'NX', 'PH', 'SC', 'SIE', 'SIQ', 'SV'])
            && (data.allowedSections.size() == 0
                || (data.isPrivate == false && data.isAssociationEvent == false));
      }

      function isOrganizer() {
        return resource.data.organizerIds.hasAny([request.auth.uid]);
      }

      function isRegistered(uid) {
        return exists(/databases/$(database)/documents/events/$(eventId)/attendees/$(uid));
      }

      // This event's path, for the rules of its subcollections (attendees, checkIns).
      function event() {
        return /databases/$(database)/documents/events/$(eventId);
      }

      // Whether the caller organizes this event, a student or a verified association
      // (canWriteEvents). A missing organizerIds (events written before #47) gives no organizer.
      // For attendees and the entrance code.
      function isEventOrganizer() {
        return canWriteEvents()
            && exists(event())
            && get(event()).data.get('organizerIds', []).hasAny([request.auth.uid]);
      }

      // Whether the caller can read this event, as its read rule says for a student: it exists,
      // and is public or lists them in allowedUids. For attendees and checkIns.
      function canReadEvent() {
        return exists(event())
            && ((get(event()).data.isPrivate == false
                    && (sectionsOpenTo(get(event()).data)
                        || get(event()).data.organizerIds.hasAny([request.auth.uid])))
                || (get(event()).data.isPrivate == true
                    && get(event()).data.allowedUids.hasAny([request.auth.uid])));
      }

      // Co-organizers (#370, decision 17): at most 5 organizers, each listed once, and every
      // one added must be registered for this event, so organizers only add students they can
      // already list (only students register). Rules can't loop, so each of the at most 4
      // added (5 organizers, one of them the creator) is checked by its index, and a fifth
      // is refused, so raising the limit can't skip a check. Any organizer adds or removes
      // co-organizers, and a co-organizer stays one after cancelling (Sprint 6 PO, #400). An
      // association event keeps its single organizer until the team decides on association
      // co-organizers.
      function keepsValidOrganizers() {
        let organizers = request.resource.data.organizerIds;
        let added = organizers.removeAll(resource.data.organizerIds);
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizerIds'])
            || (resource.data.isAssociationEvent == false
                && organizers.size() <= 5
                && organizers.toSet().size() == organizers.size()
                && added.size() <= 4
                && (added.size() < 1 || isRegistered(added[0]))
                && (added.size() < 2 || isRegistered(added[1]))
                && (added.size() < 3 || isRegistered(added[2]))
                && (added.size() < 4 || isRegistered(added[3])));
      }

      // Only a verified association may publish under its name (the verified badge), and it
      // always does: it can read only its own association events, so an event without the
      // badge would be unreadable to its own creator. Nobody is registered yet, so the creator
      // is its only organizer, and co-organizers come with an update (#370). attendeeCount is
      // the whole number 0, or absent (an event written before the counter existed counts as
      // 0 everywhere). Numbers compare by value, so `is int` is what refuses 0.0 (#372).
      allow create: if canWriteEvents()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.organizerIds == [request.auth.uid]
          && isValidEvent(request.resource.data)
          && request.resource.data.isAssociationEvent == isVerifiedAssociation()
          && request.resource.data.get('attendeeCount', 0) is int
          && request.resource.data.get('attendeeCount', 0) == 0;

      // The caller's own registration for this event.
      function ownRegistration() {
        return /databases/$(database)/documents/events/$(eventId)/attendees/$(request.auth.uid);
      }

      // The student branch of the event's read rule, on the stored event.
      function studentCanReadThisEvent() {
        return (resource.data.isPrivate == false
                && (sectionsOpenTo(resource.data)
                    || resource.data.organizerIds.hasAny([request.auth.uid])))
            || (resource.data.isPrivate == true
                && resource.data.allowedUids.hasAny([request.auth.uid]));
      }

      // Registering: the counter goes up by exactly one, stays within the capacity when it is
      // a number (null, missing or anything else is no limit), and the caller's registration,
      // missing before, exists after the same write. That document's own create rule checks
      // the rest (own UID, readable event that hasn't ended, account not deleted).
      function isRegistering() {
        let capacity = resource.data.get('capacity', null);
        let before = resource.data.get('attendeeCount', 0);
        let after = request.resource.data.attendeeCount;
        return after is int
            && after == before + 1
            && (!(capacity is number) || after <= capacity)
            && !exists(ownRegistration())
            && existsAfter(ownRegistration());
      }

      // Cancelling: the counter goes down by exactly one, never below 0, and the caller's
      // registration, there before, is deleted by the same write.
      function isCancelling() {
        let before = resource.data.get('attendeeCount', 0);
        let after = request.resource.data.attendeeCount;
        return after is int
            && after >= 0
            && after == before - 1
            && exists(ownRegistration())
            && !existsAfter(ownRegistration());
      }

      // The only change a non-organizer may make to an event (#372): a student who can read
      // it changes attendeeCount, and nothing else, with their own registration. Cancelling
      // doesn't need the read: an organizer who limits the event to other sections after the
      // student registered must not leave the place counted (#369). That holds only for a
      // public event, which every student reads but for its sections, and only for a
      // registration that exists, deleted by the same write (isCancelling).
      function countsOwnRegistration() {
        return isStudent()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount'])
            && ((studentCanReadThisEvent() && isRegistering())
                || (isCancelling()
                    && (studentCanReadThisEvent() || resource.data.isPrivate == false)));
      }

      // Any organizer manages the event. The creator, the badge and the counter are fixed for
      // them: attendeeCount only changes through countsOwnRegistration. An equal number of
      // another type (3.0 for 3) isn't a change for affectedKeys, so `is int` keeps the counter
      // whole.
      allow update: if (canWriteEvents()
              && isOrganizer()
              && isValidEvent(request.resource.data)
              && keepsValidOrganizers()
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['createdBy', 'isAssociationEvent', 'attendeeCount'])
              && request.resource.data.get('attendeeCount', 0) is int)
          || countsOwnRegistration();

      allow delete: if canWriteEvents() && isOrganizer();

      // A student's registration for this event (#121), keyed by the student's UID, with that UID
      // again in `uid` (for the collection-group query below) and the server time in
      // `registeredAt`. A student registers only themselves, for an event they can read (the
      // same check as the event's read rule) that hasn't ended yet, and can always remove their
      // own registration, even once the event has ended, is deleted or is no longer readable.
      // A deleted account can't register again with its still-valid ID token: deleteAccount
      // deletes its registrations once the marker is written (#275), so none outlives it.
      // The event's organizers read its registrations, to count its attendees. Nobody updates
      // one. Each registration is counted in the event's attendeeCount, in the same write, and
      // the event's update rule checks the capacity (#372).
      match /attendees/{uid} {
        function isSelf() {
          return isStudent() && request.auth.uid == uid;
        }

        // Like Event.isPast in the app: an event has ended once its endTime has passed, or
        // its startTime when it has no endTime. An event with neither as a timestamp counts as
        // ended, since nobody can tell.
        function hasNotEnded() {
          let data = get(event()).data;
          let end = data.get('endTime', null) is timestamp
              ? data.endTime
              : data.get('startTime', null);
          return end is timestamp && request.time < end;
        }

        // The event's attendeeCount before this write, and once the whole write (batch or
        // transaction) is applied. Missing counts as 0.
        function countBefore() {
          return get(event()).data.get('attendeeCount', 0);
        }

        function countAfter() {
          return getAfter(event()).data.get('attendeeCount', 0);
        }

        allow get: if isSelf() || isEventOrganizer();
        allow list: if isEventOrganizer();

        // A registration is counted: the same write raises the event's attendeeCount by one,
        // which the event's update rule accepts only within the capacity.
        allow create: if isSelf()
            && !isDeletedAccount(uid)
            && canReadEvent()
            && hasNotEnded()
            && request.resource.data.keys().hasOnly(['uid', 'registeredAt'])
            && request.resource.data.uid == uid
            && request.resource.data.registeredAt == request.time
            && countAfter() == countBefore() + 1;

        // Cancelling lowers the counter in the same write, so nobody frees or keeps a place
        // they don't hold. It is still always possible: nothing is counted for a registration
        // that doesn't exist, an event that is gone or no longer readable, or a counter already
        // at 0.
        allow delete: if isSelf()
            && (resource == null
                || !canReadEvent()
                || countBefore() == 0
                || countAfter() == countBefore() - 1);
      }

      // The end of the check-in window (#374), as checkInWindow(event) in the app: the event's
      // endTime, or 3 hours after its startTime without one. A startTime that isn't a timestamp
      // fails the rule, so no check-in is allowed.
      function checkInWindowEnd() {
        let data = get(event()).data;
        return data.get('endTime', null) is timestamp
            ? data.endTime
            : data.startTime + duration.value(3, 'h');
      }

      // Whether now is in the check-in window: from 30 minutes before the start (included) to
      // its end (excluded).
      function inCheckInWindow() {
        return request.time >= get(event()).data.startTime - duration.value(30, 'm')
            && request.time < checkInWindowEnd();
      }

      // A student's check-in at the venue (#467, designed in #374, Architecture Diagram 3.10),
      // keyed by their UID, with that UID again in `uid` (for #472's collection-group cleanup),
      // the server time in `checkedInAt`, `method` and `expiresAt`, the window's end + 30 days,
      // computed here so the app can't keep a check-in longer: a TTL policy on expiresAt
      // deletes it. Never a location: the app compares the fix with the venue on the device, so
      // a modified app could fake one (accepted in #374: the stakes are the group's "arrived").
      // Only a registered student who can still read the event (a student removed from a
      // private event's allowedUids keeps their registration, #295, but not check-in) checks
      // in, as themselves, during the window, by location for now (the entrance QR method comes with #468). The student and the members of their
      // group for this event read it, by ID only; the event's organizers don't (no screen needs
      // it). Nobody lists or updates one. The student deletes their own, as cancelling their
      // registration does in the same write. A deleted account can't check in or read.
      match /checkIns/{uid} {
        function isSelf() {
          return isStudent() && request.auth.uid == uid;
        }

        // Whether the caller and the check-in's student are in the same group of this event,
        // by their groupMembers markers (#232), which always name the group they're in.
        function sameGroup() {
          let mine = /databases/$(database)/documents/events/$(eventId)/groupMembers/$(request.auth.uid);
          let theirs = /databases/$(database)/documents/events/$(eventId)/groupMembers/$(uid);
          return exists(mine) && exists(theirs)
              && get(mine).data.groupId == get(theirs).data.groupId;
        }

        allow get: if isStudent()
            && !isDeletedAccount(request.auth.uid)
            && (request.auth.uid == uid || sameGroup());

        // The event's entrance code (#468), read only for a QR check-in, so a location check-in
        // never needs one.
        function code() {
          return get(/databases/$(database)/documents/events/$(eventId)/checkInCode/current).data;
        }

        // A location check-in carries no token. A QR check-in carries the entrance code's
        // current or previous token, each less than 2 minutes after it was issued, so a
        // forwarded screenshot stops working (#374). The previous token is judged by its own
        // issue time, not by the latest rotation's: a rotation after a pause must not make an
        // expired token work again (#531's review).
        function validToken(token) {
          return (token == code().token
                  && request.time < code().rotatedAt + duration.value(2, 'm'))
              || (token == code().get('previousToken', null)
                  && request.time < code().previousRotatedAt + duration.value(2, 'm'));
        }

        function validMethod(data) {
          return (data.method == 'location'
                  && data.keys().hasOnly(['uid', 'checkedInAt', 'method', 'expiresAt']))
              || (data.method == 'qr'
                  && data.keys().hasOnly(['uid', 'checkedInAt', 'method', 'expiresAt', 'token'])
                  && data.token is string
                  && validToken(data.token));
        }

        allow create: if isSelf()
            && !isDeletedAccount(uid)
            && isRegistered(uid)
            && canReadEvent()
            && inCheckInWindow()
            && request.resource.data.uid == uid
            && request.resource.data.checkedInAt == request.time
            && request.resource.data.expiresAt == checkInWindowEnd() + duration.value(30, 'd')
            && validMethod(request.resource.data);

        allow delete: if isSelf();
      }

      // The entrance code an organizer shows (#468, designed in #374, Architecture Diagram
      // 3.10): one document, `current`, with a random 22-character base64url `token` (it passes
      // #337's QR ID check), the `previousToken` and `previousRotatedAt` (when it was issued),
      // the server's `rotatedAt` and `expiresAt`, the window's end + 30 days, so the TTL policy
      // deletes it with the check-ins. Only the event's organizers (a student or a verified
      // association) read and write it, during the window, by ID. A rotation keeps the stored
      // token and rotatedAt as previousToken and previousRotatedAt, so a student scanning as it
      // changes still checks in, and comes at least 50 s after the last one, so a phone with a
      // wrong clock or a modified app can't rotate it every second (the app rotates every
      // 60 s). Nobody lists or deletes it: deleteEventRegistrations does with the event (#472).
      match /checkInCode/{codeId} {
        function validCode(data) {
          return data.keys().hasOnly(
                  ['token', 'previousToken', 'previousRotatedAt', 'rotatedAt', 'expiresAt'])
              && data.token is string
              && data.token.matches('[A-Za-z0-9_-]{22}')
              && data.rotatedAt == request.time
              && data.expiresAt == checkInWindowEnd() + duration.value(30, 'd');
        }

        function canUseCode() {
          return codeId == 'current'
              && isEventOrganizer()
              && !isDeletedAccount(request.auth.uid)
              && inCheckInWindow();
        }

        allow get: if canUseCode();

        allow create: if canUseCode()
            && validCode(request.resource.data)
            && !('previousToken' in request.resource.data)
            && !('previousRotatedAt' in request.resource.data);

        allow update: if canUseCode()
            && validCode(request.resource.data)
            && request.resource.data.get('previousToken', null) == resource.data.token
            && request.resource.data.get('previousRotatedAt', null) == resource.data.rotatedAt
            && request.resource.data.token != resource.data.token
            && request.time >= resource.data.rotatedAt + duration.value(50, 's');
      }
    }

    // A student's own registrations across events (#121), for My events and "I'm going": the
    // collection-group query `attendees where uid == <their UID>`. Rules aren't filters, so a
    // query that doesn't constrain uid to the caller is denied.
    match /{path=**}/attendees/{uid} {
      allow list: if isStudent() && resource.data.uid == request.auth.uid;
    }

    // An event's groups (#228, built by #232), the second reachable event subcollection after
    // attendees: capacity (4, stored so it can change), memberUids (1 to capacity UIDs, the creator
    // first), createdBy and the server's createdAt. A student who can read the event (the same
    // check as the event's read rule) reads its groups, starts one, or joins one. A member also
    // reads their own group once they can no longer read the event, so they can still leave it.
    // Each write changes only the caller's own UID in memberUids, always together with their
    // groupMembers marker (below, checked with getAfter), which keeps a student in at most one
    // group per event. The capacity is checked here, so it needs no counter; the client's
    // transaction stops two students taking the last place. The last member to leave deletes the
    // group. Associations get no access (isStudent).
    match /events/{eventId}/groups/{groupId} {
      function event() {
        return /databases/$(database)/documents/events/$(eventId);
      }

      function ownMarker() {
        return /databases/$(database)/documents/events/$(eventId)/groupMembers/$(request.auth.uid);
      }

      function canReadEvent() {
        return exists(event())
            && ((get(event()).data.isPrivate == false
                    && (sectionsOpenTo(get(event()).data)
                        || get(event()).data.organizerIds.hasAny([request.auth.uid])))
                || (get(event()).data.isPrivate == true
                    && get(event()).data.allowedUids.hasAny([request.auth.uid])));
      }

      // After this write, the caller's marker names this group. A missing marker fails.
      function ownMarkerNamesThisGroupAfter() {
        return getAfter(ownMarker()).data.groupId == groupId;
      }

      // Joining appends the caller's UID, within the capacity, and creates their marker.
      function isJoining() {
        let before = resource.data.memberUids;
        let after = request.resource.data.memberUids;
        return !isDeletedAccount(request.auth.uid)
            && canReadEvent()
            && !before.hasAny([request.auth.uid])
            && after == before.concat([request.auth.uid])
            && after.size() <= resource.data.capacity
            && !exists(ownMarker())
            && ownMarkerNamesThisGroupAfter();
      }

      // Leaving removes only the caller's UID, leaves someone in the group (the last member
      // deletes it instead), and deletes their marker.
      function isLeaving() {
        let before = resource.data.memberUids;
        let after = request.resource.data.memberUids;
        return before.hasAny([request.auth.uid])
            && after == before.removeAll([request.auth.uid])
            && after.size() > 0
            && !existsAfter(ownMarker());
      }

      allow list: if isStudent() && canReadEvent();
      // A member removed from a private event's allowedUids still gets their group, so they can
      // leave it. That shows them nothing new: they already list it through /{path=**}/groups.
      allow get: if isStudent()
          && (canReadEvent() || resource.data.memberUids.hasAny([request.auth.uid]));
      // exists() reads the marker as it was before this write: a student who already has one
      // can't start a group, whatever the marker rules allow.
      allow create: if isStudent()
          && canReadEvent()
          && !isDeletedAccount(request.auth.uid)
          && request.resource.data.keys().hasOnly(['capacity', 'memberUids', 'createdBy', 'createdAt'])
          && request.resource.data.capacity == 4
          && request.resource.data.memberUids == [request.auth.uid]
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !exists(ownMarker())
          && ownMarkerNamesThisGroupAfter();
      allow update: if isStudent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && (isJoining() || isLeaving());
      allow delete: if isStudent()
          && resource.data.memberUids == [request.auth.uid]
          && !existsAfter(ownMarker());
    }

    // A student's own groups across events (#232): the collection-group query
    // `groups where memberUids array-contains <their UID>`. Rules aren't filters, so a query that
    // doesn't constrain memberUids to the caller is denied.
    match /{path=**}/groups/{groupId} {
      allow list: if isStudent() && resource.data.memberUids.hasAny([request.auth.uid]);
    }

    // A student's marker for an event's groups (#232), keyed by their UID: groupId names their
    // group for the event, so a transaction, which can't run a query, sees whether they are
    // already in one. Only that student reads, creates or deletes it, in the same write as their
    // memberUids change: a new marker names a group whose memberUids contain them after the write,
    // and it is deleted only once they are no longer in that group. Nobody updates one, so a
    // student can't switch groups without leaving the first. Associations get no access.
    match /events/{eventId}/groupMembers/{uid} {
      function isSelf() {
        return isStudent() && request.auth.uid == uid;
      }

      function group(id) {
        return /databases/$(database)/documents/events/$(eventId)/groups/$(id);
      }

      allow get: if isSelf();
      allow create: if isSelf()
          && request.resource.data.keys().hasOnly(['groupId'])
          && !isDeletedAccount(request.auth.uid)
          && request.resource.data.groupId is string
          && request.resource.data.groupId.matches('[^/]+')
          && getAfter(group(request.resource.data.groupId)).data.memberUids.hasAny([uid]);
      allow delete: if isSelf()
          && !(existsAfter(group(resource.data.groupId))
              && getAfter(group(resource.data.groupId)).data.memberUids.hasAny([uid]));
    }

    // A group's chat (#237): each message has exactly senderId, text (1 to 1000 characters,
    // counted like the app's MAX_MESSAGE_LENGTH) and the server's createdAt. Only the group's
    // members read and send, each message as themselves; no client edits or deletes one (report
    // and block come later). Membership is read from the group itself, as its own get rule does:
    // a member removed from a private event's allowedUids still reaches their group (#295), so
    // they keep its chat too. A deleted account cannot read or send (isDeletedAccount): deleteAccount
    // removes membership later, and its ID token stays valid for up to an hour, so it could
    // otherwise still write new personal data after the deletion. Each operation has its own
    // rule, so a rate limit can be added to create without touching reads. Associations get no
    // access (isStudent). Account cleanup alone replaces senderId with an empty string, retaining
    // text/time; clients cannot forge that deleted-author marker or restore its account link.
    match /events/{eventId}/groups/{groupId}/messages/{messageId} {
      function isMember() {
        let group = /databases/$(database)/documents/events/$(eventId)/groups/$(groupId);
        return isStudent()
            && !isDeletedAccount(request.auth.uid)
            && exists(group)
            && get(group).data.memberUids.hasAny([request.auth.uid]);
      }

      allow get, list: if isMember();
      allow create: if isMember() && isNewMessage();
    }

    // A friend request or friendship between two students (#357, designed in #338), one document
    // per pair: pairId is the two UIDs sorted and joined by '~' (friendshipId in the app). It holds
    // uids (the two, sorted), requestedBy, status ('pending', then 'accepted') and the server's
    // createdAt and acceptedAt. Declining, cancelling and removing delete it. Only the two
    // students reach it, never while marked deleted (their ID token outlives deleteAccount by up
    // to an hour); associations never do. Each operation has its own rule, so a rate limit or a
    // block list can be added to one later. deleteAccount deletes an account's friendships with
    // the Admin SDK.
    match /friendships/{pairId} {
      function isActiveStudent() {
        return isStudent() && !isDeletedAccount(request.auth.uid);
      }

      // Whether users/[uid] is an association's, as stored now.
      function isAssociationAccount(uid) {
        let profile = /databases/$(database)/documents/users/$(uid);
        return exists(profile) && get(profile).data.get('accountType', 'student') == 'association';
      }

      // Whether the caller's users/{uid} is an association's once this write is applied: isStudent()
      // reads it before the write, so a batch that creates an association's profile would still
      // pass as a student's (#416 review).
      function becomesAssociation() {
        let profile = getAfter(/databases/$(database)/documents/users/$(request.auth.uid));
        return profile != null && profile.data.get('accountType', 'student') == 'association';
      }

      // The UID of the request's other student.
      function recipient() {
        let uids = request.resource.data.uids;
        return uids[0] == request.auth.uid ? uids[1] : uids[0];
      }

      // A student reads their own pair's document, or the missing one under their own pair ID:
      // the app's transactions read it before sending, accepting or removing, and a missing
      // document has no uids to check. A third student is refused either way, so nobody can
      // tell whether two others are friends.
      allow get: if isActiveStudent()
          && (resource == null
              ? isPairIdOf(pairId, request.auth.uid)
              : request.auth.uid in resource.data.uids);

      // Only the query uids array-contains <own UID>, so nobody lists other students' friendships.
      allow list: if isActiveStudent() && request.auth.uid in resource.data.uids;

      // Sending a request: as yourself, to a student with a public profile (so never to an
      // association, a deleted account or a made-up UID), pending, at the server's time, with
      // exactly these four fields, under the pair's exact ID. Neither student may be an
      // association: not the recipient as stored now (an old public profile alone isn't enough),
      // nor the sender after this write (not in the batch that creates its association profile).
      allow create: if isActiveStudent()
          && !becomesAssociation()
          && request.resource.data.keys().hasOnly(['uids', 'requestedBy', 'status', 'createdAt'])
          && request.resource.data.uids is list
          && request.resource.data.uids.size() == 2
          && request.resource.data.uids[0] < request.resource.data.uids[1]
          && pairId == request.resource.data.uids[0] + '~' + request.resource.data.uids[1]
          && request.resource.data.requestedBy == request.auth.uid
          && request.auth.uid in request.resource.data.uids
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(recipient()))
          && !isAssociationAccount(recipient());

      // Accepting: only the recipient (one of the pair, not requestedBy), only a pending request,
      // changing only status to 'accepted' and acceptedAt to the server's time, and only while
      // neither student is marked deleted.
      allow update: if isActiveStudent()
          && request.auth.uid in resource.data.uids
          && resource.data.requestedBy != request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
          && !isDeletedAccount(resource.data.requestedBy);

      // Declining, cancelling or removing: either student. The rules can't tell these apart (a
      // delete carries no data), so the app checks that the document is still the one it showed.
      allow delete: if isActiveStudent() && request.auth.uid in resource.data.uids;
    }

    // A chat between two friends (#428, designed in #365, Architecture Diagram 3.8):
    // chats/{pairId} under the pair's friendship ID, holding exactly uids (the two UIDs in the ID's
    // order), and its messages, with group chat's fields. The pair comes from the document ID,
    // which must be exactly {lowerUid}~{higherUid} (isPairIdOf), so a chat that doesn't exist yet
    // reads as missing to the two students (the first message's transaction reads it) and is
    // refused to anyone else; a query has no single ID to check, so a list checks uids. Students
    // only, never under a deletion marker (their ID token outlives deleteAccount by up to an hour).
    // Reading doesn't need the friendship, so the conversation stays readable after unfriending;
    // creating the chat and sending need friendships/{pairId} to be accepted. The first message
    // creates the chat in the same write, and no message is stored without its chat. No client
    // updates or deletes a chat or a message: the step #429 adds to deleteAccount (Admin SDK) takes
    // a deleted UID out of uids, or deletes the chat once nobody else is left. Each operation has
    // its own rule, so a block check or a rate limit can be added to one later.
    match /chats/{pairId} {
      function isOfThePair() {
        return isStudent()
            && !isDeletedAccount(request.auth.uid)
            && isPairIdOf(pairId, request.auth.uid);
      }

      allow get: if isOfThePair();
      // Only a query that can return nothing but the caller's chats, such as uids array-contains
      // <own UID>. A chat whose other account was deleted holds only the remaining UID, and is
      // still listed by it.
      allow list: if isStudent()
          && !isDeletedAccount(request.auth.uid)
          && resource.data.uids.hasAny([request.auth.uid]);
      allow create: if isOfThePair()
          && isAcceptedFriendship(pairId)
          && request.resource.data.keys().hasOnly(['uids'])
          && request.resource.data.uids == pairId.split('~');

      match /messages/{messageId} {
        allow get, list: if isOfThePair();
        allow create: if isOfThePair()
            && isAcceptedFriendship(pairId)
            && existsAfter(/databases/$(database)/documents/chats/$(pairId))
            && isNewMessage();
      }
    }

    // An association's public profile (#126), keyed by the association account's UID. Its
    // owner, an account whose users/{uid} is an association's, reads and writes it from sign-up
    // on, before an admin has verified it, so it can set it up while its review is pending.
    // Besides its own users/{uid}, that is the only exception to "no access before
    // verification". Students read it only once an admin has verified the association
    // (users/{uid}.isAssociationVerified, read here with get(), so students never see
    // users/{uid} itself); other associations never do. Once verified, its name and type are
    // fixed, so a verified badge can't move to another name. Nobody lists the collection, and
    // only an admin deletes a document.
    match /associations/{uid} {
      function isAssociationOwner() {
        let profile = /databases/$(database)/documents/users/$(request.auth.uid);
        return hasVerifiedEmail()
            && request.auth.uid == uid
            && exists(profile)
            && get(profile).data.get('accountType', null) == 'association';
      }

      function isVerifiedAssociation() {
        let owner = /databases/$(database)/documents/users/$(uid);
        return exists(owner)
            && get(owner).data.get('accountType', null) == 'association'
            && get(owner).data.get('isAssociationVerified', false) == true;
      }

      // The fields of the Figma "Association setup" frame, with the app's limits, and nothing
      // else: no email, no verification flag. A missing name, type or about fails its check
      // below, and a missing createdAt fails request.time on create and is a change on update.
      function isValidAssociation(data) {
        return data.keys().hasOnly(['name', 'type', 'about', 'website', 'createdAt'])
            && data.name is string
            && data.name.trim().size() > 0
            && data.name.size() <= 60
            && data.type in ['ASSOCIATION', 'COMMISSION', 'CLUB', 'EPFL_UNIT']
            && data.about is string
            && data.about.trim().size() > 0
            && data.about.size() <= 1000
            && (!('website' in data)
                || (data.website is string
                    && data.website.size() <= 200
                    && data.website.matches('https://[^\\s]+')));
      }

      allow get: if isAssociationOwner() || (isStudent() && isVerifiedAssociation());

      allow create: if isAssociationOwner()
          && isValidAssociation(request.resource.data)
          && request.resource.data.createdAt == request.time;

      allow update: if isAssociationOwner()
          && isValidAssociation(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
          && !(isVerifiedAssociation()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['name', 'type']));
    }
  }
}
