// Contributors: Claude (isEpflUser helper, #33; own users/{uid} rule and no catch-all, #35;
// fixed uid and accountType after review, #35; @epfl.ch associations aren't students and
// accountType values on create, association profiles not deletable by the client, #161;
// associations/{uid}, #126; displayName limit, written test-first, #143);
// OpenAI Codex (public/private event read rules, #52); Claude Opus 5.5 (event write rules, #47;
// badge and locationName checks after review; isStudent for writes after #161; organizers
// stay allowed readers after review; event registrations, #121).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified email address (a student or an association).
    function hasVerifiedEmail() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Signed in with a verified @epfl.ch email address.
    function isEpflUser() {
      return hasVerifiedEmail()
          && request.auth.token.email.matches('[^@]+@epfl[.]ch');
    }

    // A student: a verified @epfl.ch account whose profile isn't an association's. An association
    // can have an @epfl.ch email too, and then gets only association access (#161). Only a
    // profile with accountType "association" removes student access: a student has no profile
    // yet during the profile step, accountType is "student" or "association" when present, and
    // it can't change once the profile exists.
    function isStudent() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return isEpflUser()
          && !(exists(profile) && get(profile).data.get('accountType', 'student') == 'association');
    }

    // Each account's private profile. Open to any verified email (most associations have no
    // EPFL email); besides it, an unverified association reaches only its own
    // associations/{uid} (#126).
    // Only an admin sets isAssociationVerified, in the Firebase console. The uid field names
    // the document's owner, and uid and accountType are fixed once created, so an admin
    // verifying an account isn't misled. An association can't delete its own profile: without
    // it, an @epfl.ch association would count as a student again (#161). An admin deletes
    // association accounts instead.
    match /users/{uid} {
      function isOwner() {
        return hasVerifiedEmail() && request.auth.uid == uid;
      }

      // The full name's limit (#143): a displayName, when present, is a string of at most 50
      // characters (the app's MAX_DISPLAY_NAME_LENGTH). size() counts UTF-16 units, as the app does.
      function hasValidDisplayName() {
        return !('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50);
      }

      allow read: if isOwner();
      allow delete: if isOwner()
          && (resource == null || resource.data.get('accountType', 'student') != 'association');
      allow create: if isOwner()
          && request.resource.data.uid == uid
          && (!('accountType' in request.resource.data)
              || request.resource.data.accountType in ['student', 'association'])
          && (!('isAssociationVerified' in request.resource.data)
              || request.resource.data.isAssociationVerified == false)
          && hasValidDisplayName();
      allow update: if isOwner()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['uid', 'accountType', 'isAssociationVerified'])
          && hasValidDisplayName();
    }

    // Of the event subcollections, only attendees (below) is reachable. Private queries also need
    // isPrivate == true and allowedUids array-contains auth.uid; public queries need
    // isPrivate == false.
    match /events/{eventId} {
      function isVerifiedAssociationOwner() {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return hasVerifiedEmail()
            && profile.accountType == 'association'
            && profile.isAssociationVerified == true
            && resource.data.isAssociationEvent == true
            && resource.data.createdBy == request.auth.uid;
      }

      allow read: if (isStudent()
          && (resource.data.isPrivate == false
              || (resource.data.isPrivate == true
                  && resource.data.allowedUids.hasAny([request.auth.uid]))))
          || (hasVerifiedEmail() && isVerifiedAssociationOwner());

      function callerProfile() {
        return /databases/$(database)/documents/users/$(request.auth.uid);
      }

      // Read from the protected users/{uid}, never from token claims. A student without a
      // profile yet, or whose profile has no accountType, is not an association.
      function isAssociationAccount() {
        return exists(callerProfile())
            && get(callerProfile()).data.get('accountType', null) == 'association';
      }

      function isVerifiedAssociation() {
        return isAssociationAccount()
            && get(callerProfile()).data.get('isAssociationVerified', false) == true;
      }

      // Who may create and manage events: a student (isStudent, the same check as reads), or an
      // association a PolySocial admin has verified. An association account with an @epfl.ch
      // email still needs that verification.
      function canWriteEvents() {
        return hasVerifiedEmail() && (isVerifiedAssociation() || isStudent());
      }

      // The limits of validateNewEvent (title, description), MAX_LOCATION_NAME_LENGTH and the
      // EventCategory names. Events saved before locationName existed don't have it. The
      // creator always stays an organizer, and every organizer is an allowed reader, so no
      // organizer can manage a private event they can't read.
      function isValidEvent(data) {
        return data.title is string
            && data.title.trim().size() > 0
            && data.title.size() <= 80
            && data.description is string
            && data.description.size() <= 5000
            && (!('locationName' in data)
                || (data.locationName is string && data.locationName.size() <= 100))
            && data.category in ['STUDY', 'SPORTS', 'CULTURE', 'PARTY', 'OTHER']
            && data.isPrivate is bool
            && data.isAssociationEvent is bool
            && data.organizerIds is list
            && data.organizerIds.hasAny([data.createdBy])
            && data.allowedUids is list
            && data.allowedUids.hasAll(data.organizerIds);
      }

      function isOrganizer() {
        return resource.data.organizerIds.hasAny([request.auth.uid]);
      }

      // Only a verified association may publish under its name (the verified badge), and it
      // always does: it can read only its own association events, so an event without the
      // badge would be unreadable to its own creator.
      allow create: if canWriteEvents()
          && request.resource.data.createdBy == request.auth.uid
          && isValidEvent(request.resource.data)
          && request.resource.data.isAssociationEvent == isVerifiedAssociation();

      // Any organizer manages the event. The creator and the badge are fixed once created.
      allow update: if canWriteEvents()
          && isOrganizer()
          && isValidEvent(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['createdBy', 'isAssociationEvent']);

      allow delete: if canWriteEvents() && isOrganizer();

      // A student's registration for this event (#121), keyed by the student's UID, with that UID
      // again in `uid` (for the collection-group query below) and the server time in
      // `registeredAt`. A student registers only themselves, for an event they can read (the
      // same check as the event's read rule) that hasn't ended yet, and can always remove their
      // own registration, even once the event has ended, is deleted or is no longer readable.
      // The event's organizers read its registrations, to count its attendees. Nobody updates
      // one. The capacity isn't checked yet: that needs a team decision on how a student may
      // count attendees.
      match /attendees/{uid} {
        function event() {
          return /databases/$(database)/documents/events/$(eventId);
        }

        function isSelf() {
          return isStudent() && request.auth.uid == uid;
        }

        function canReadEvent() {
          return exists(event())
              && (get(event()).data.isPrivate == false
                  || (get(event()).data.isPrivate == true
                      && get(event()).data.allowedUids.hasAny([request.auth.uid])));
        }

        // Like Event.isPast in the app: an event has ended once its endTime has passed, or
        // its startTime when it has no endTime. An event with neither as a timestamp counts as
        // ended, since nobody can tell.
        function hasNotEnded() {
          let data = get(event()).data;
          let end = data.get('endTime', null) is timestamp
              ? data.endTime
              : data.get('startTime', null);
          return end is timestamp && request.time < end;
        }

        // A missing organizerIds (events written before #47) gives no organizer.
        function isEventOrganizer() {
          return canWriteEvents()
              && exists(event())
              && get(event()).data.get('organizerIds', []).hasAny([request.auth.uid]);
        }

        allow get: if isSelf() || isEventOrganizer();
        allow list: if isEventOrganizer();
        allow create: if isSelf()
            && canReadEvent()
            && hasNotEnded()
            && request.resource.data.keys().hasOnly(['uid', 'registeredAt'])
            && request.resource.data.uid == uid
            && request.resource.data.registeredAt == request.time;
        allow delete: if isSelf();
      }
    }

    // A student's own registrations across events (#121), for My events and "I'm going": the
    // collection-group query `attendees where uid == <their UID>`. Rules aren't filters, so a
    // query that doesn't constrain uid to the caller is denied.
    match /{path=**}/attendees/{uid} {
      allow list: if isStudent() && resource.data.uid == request.auth.uid;
    }

    // An association's public profile (#126), keyed by the association account's UID. Its
    // owner, an account whose users/{uid} is an association's, reads and writes it from sign-up
    // on, before an admin has verified it, so it can set it up while its review is pending.
    // Besides its own users/{uid}, that is the only exception to "no access before
    // verification". Students read it only once an admin has verified the association
    // (users/{uid}.isAssociationVerified, read here with get(), so students never see
    // users/{uid} itself); other associations never do. Once verified, its name and type are
    // fixed, so a verified badge can't move to another name. Nobody lists the collection, and
    // only an admin deletes a document.
    match /associations/{uid} {
      function isAssociationOwner() {
        let profile = /databases/$(database)/documents/users/$(request.auth.uid);
        return hasVerifiedEmail()
            && request.auth.uid == uid
            && exists(profile)
            && get(profile).data.get('accountType', null) == 'association';
      }

      function isVerifiedAssociation() {
        let owner = /databases/$(database)/documents/users/$(uid);
        return exists(owner)
            && get(owner).data.get('accountType', null) == 'association'
            && get(owner).data.get('isAssociationVerified', false) == true;
      }

      // The fields of the Figma "Association setup" frame, with the app's limits, and nothing
      // else: no email, no verification flag. A missing name, type or about fails its check
      // below, and a missing createdAt fails request.time on create and is a change on update.
      function isValidAssociation(data) {
        return data.keys().hasOnly(['name', 'type', 'about', 'website', 'createdAt'])
            && data.name is string
            && data.name.trim().size() > 0
            && data.name.size() <= 60
            && data.type in ['ASSOCIATION', 'COMMISSION', 'CLUB', 'EPFL_UNIT']
            && data.about is string
            && data.about.trim().size() > 0
            && data.about.size() <= 1000
            && (!('website' in data)
                || (data.website is string
                    && data.website.size() <= 200
                    && data.website.matches('https://[^\\s]+')));
      }

      allow get: if isAssociationOwner() || (isStudent() && isVerifiedAssociation());

      allow create: if isAssociationOwner()
          && isValidAssociation(request.resource.data)
          && request.resource.data.createdAt == request.time;

      allow update: if isAssociationOwner()
          && isValidAssociation(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
          && !(isVerifiedAssociation()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['name', 'type']));
    }
  }
}
