// Contributors: Claude (isEpflUser helper, #33; own users/{uid} rule and no catch-all, #35;
// fixed uid and accountType after review, #35; @epfl.ch associations aren't students and
// accountType values on create, association profiles not deletable by the client, #161;
// associations/{uid}, #126; displayName limit, written test-first, #143; publicProfiles/{uid},
// written test-first, #229; reads by ID only and fixed section and year lists, after review, #229;
// deleted accounts stay deleted and private edits keep the public copy, after review, #229;
// interests from the fixed list, written test-first, #230);
// OpenAI Codex (public/private event read rules, #52); Claude Opus 5.5 (event write rules, #47;
// badge and locationName checks after review; isStudent for writes after #161; organizers
// stay allowed readers after review; event registrations, #121); Claude (Opus 5.5, Anthropic)
// (event groups and their groupMembers markers, #232, with fixes after review; group chat
// messages, #237, and no messages from a deleted account, after review).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified email address (a student or an association).
    function hasVerifiedEmail() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Signed in with a verified @epfl.ch email address.
    function isEpflUser() {
      return hasVerifiedEmail()
          && request.auth.token.email.matches('[^@]+@epfl[.]ch');
    }

    // A student: a verified @epfl.ch account whose profile isn't an association's. An association
    // can have an @epfl.ch email too, and then gets only association access (#161). Only a
    // profile with accountType "association" removes student access: a student has no profile
    // yet during the profile step, accountType is "student" or "association" when present, and
    // it can't change once the profile exists.
    function isStudent() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return isEpflUser()
          && !(exists(profile) && get(profile).data.get('accountType', 'student') == 'association');
    }

    // Whether deleteAccount deleted this account: it writes deletedAccounts/{uid} in the transaction
    // that deletes both profiles (#229 review). The deleted user's ID token stays valid until it
    // expires, so without it another of their devices could recreate the profiles afterwards, and
    // other students could read the public one; it could also still send messages to its groups
    // (#237). Firebase never reuses a UID. The app can't read or write deletedAccounts: no rule
    // matches it.
    function isDeletedAccount(uid) {
      return exists(/databases/$(database)/documents/deletedAccounts/$(uid));
    }

    // The interest codes the app offers (#230): keep them equal to INTERESTS in
    // app/src/main/java/com/polysocial/model/user/ProfileOptions.kt. The rules tests read that file
    // and fail if the two lists differ.
    function interestCodes() {
      return ['sports', 'outdoors', 'music', 'parties', 'cinema', 'games', 'photography',
          'cooking', 'tech', 'startups', 'arts', 'volunteering'];
    }

    // No interests (a profile saved before #230), or a list of known codes, each at most once, so
    // at most one of each. An association's profile holds an empty list: it gets no matching.
    function hasKnownInterests(data) {
      return !('interests' in data)
          || (data.interests is list
              && data.interests.hasOnly(interestCodes())
              && data.interests.toSet().size() == data.interests.size());
    }

    // Each account's private profile. Open to any verified email (most associations have no
    // EPFL email); besides it, an unverified association reaches only its own
    // associations/{uid} (#126).
    // Only an admin sets isAssociationVerified, in the Firebase console. The uid field names
    // the document's owner, and uid and accountType are fixed once created, so an admin
    // verifying an account isn't misled. An association can't delete its own profile: without
    // it, an @epfl.ch association would count as a student again (#161). An admin deletes
    // association accounts instead.
    match /users/{uid} {
      function isOwner() {
        return hasVerifiedEmail() && request.auth.uid == uid;
      }

      // The full name's limit (#143): a displayName, when present, is a string of at most 50
      // characters (the app's MAX_DISPLAY_NAME_LENGTH). size() counts UTF-16 units, as the app does.
      function hasValidDisplayName() {
        return !('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 50);
      }

      // Once a public profile exists, a change to a field it copies must update it in the same
      // write, so other students never see stale values (#229 review). A profile saved before #229
      // has no public copy yet, and an association never gets one: neither needs it. Removing a
      // copied field fails the comparison too.
      function keepsPublicProfile() {
        let copied = ['displayName', 'section', 'year', 'interests'];
        let publicProfile = /databases/$(database)/documents/publicProfiles/$(uid);
        let data = request.resource.data;
        return !data.diff(resource.data).affectedKeys().hasAny(copied)
            || !exists(publicProfile)
            || (getAfter(publicProfile).data.displayName == data.get('displayName', null)
                && getAfter(publicProfile).data.section == data.get('section', null)
                && getAfter(publicProfile).data.year == data.get('year', null)
                && getAfter(publicProfile).data.interests == data.get('interests', []));
      }

      allow read: if isOwner();
      allow delete: if isOwner()
          && (resource == null || resource.data.get('accountType', 'student') != 'association');
      allow create: if isOwner()
          && !isDeletedAccount(uid)
          && request.resource.data.uid == uid
          && (!('accountType' in request.resource.data)
              || request.resource.data.accountType in ['student', 'association'])
          && (!('isAssociationVerified' in request.resource.data)
              || request.resource.data.isAssociationVerified == false)
          && hasValidDisplayName()
          && hasKnownInterests(request.resource.data);
      allow update: if isOwner()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['uid', 'accountType', 'isAssociationVerified'])
          && hasValidDisplayName()
          && hasKnownInterests(request.resource.data)
          && keepsPublicProfile();
    }

    // What other students see of a student (#229): exactly displayName, section, year and
    // interests, never the email. Any student reads one by its UID, to match with and show group
    // members, but can't list the collection, so no student directory is exposed; associations
    // read none. Only its owner writes it, a student, and only as a copy of their users/{uid} as it
    // is after the same write (getAfter), so it is written with the private profile and can't say
    // anything else. Because others read them, section and year must be codes the app offers.
    // users/{uid} can't change a copied field without it (keepsPublicProfile), and a deleted
    // account can't write it again (isDeletedAccount).
    // interests are codes from the fixed list (#230), in the private profile's order; a private
    // profile saved before #230 has none, so its copy has []. Nobody deletes it from the app:
    // deleteAccount removes it with the account (a client deleting users/{uid} directly, which the
    // app never does, would leave it behind until then). Each copied field is compared, so a
    // missing one, or a missing users/{uid}, makes the rule fail and deny.
    match /publicProfiles/{uid} {
      // The codes the app offers: keep them equal to SECTIONS and YEARS in
      // app/src/main/java/com/polysocial/model/user/ProfileOptions.kt. The rules tests read that
      // file and fail if a code it offers is refused here.
      function isKnownSection(section) {
        return section in ['AR', 'CGC', 'CMS', 'EL', 'GC', 'GM', 'IF', 'IN', 'MA', 'MT', 'MTE',
            'MX', 'NX', 'PH', 'SC', 'SIE', 'SIQ', 'SV'];
      }

      function isKnownYear(year) {
        return year in ['BA1', 'BA2', 'BA3', 'BA4', 'BA5', 'BA6', 'MA1', 'MA2', 'MA3', 'MA4'];
      }

      function privateProfileAfter() {
        return getAfter(/databases/$(database)/documents/users/$(uid));
      }

      function copiesPrivateProfile() {
        let data = request.resource.data;
        let fields = ['displayName', 'section', 'year', 'interests'];
        let owner = privateProfileAfter().data;
        return data.keys().hasOnly(fields)
            && owner.get('accountType', 'student') == 'student'
            && data.displayName == owner.displayName
            && data.section == owner.section
            && data.year == owner.year
            && isKnownSection(data.section)
            && isKnownYear(data.year)
            && data.interests == owner.get('interests', [])
            && hasKnownInterests(data);
      }

      allow get: if isStudent();
      allow create, update: if isStudent()
          && request.auth.uid == uid
          && !isDeletedAccount(uid)
          && copiesPrivateProfile();
    }

    // Of the event subcollections, only attendees (below), groups, their messages and
    // groupMembers (after this block) are reachable. Private queries also need isPrivate == true
    // and allowedUids array-contains auth.uid; public queries need isPrivate == false.
    match /events/{eventId} {
      function isVerifiedAssociationOwner() {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return hasVerifiedEmail()
            && profile.accountType == 'association'
            && profile.isAssociationVerified == true
            && resource.data.isAssociationEvent == true
            && resource.data.createdBy == request.auth.uid;
      }

      allow read: if (isStudent()
          && (resource.data.isPrivate == false
              || (resource.data.isPrivate == true
                  && resource.data.allowedUids.hasAny([request.auth.uid]))))
          || (hasVerifiedEmail() && isVerifiedAssociationOwner());

      function callerProfile() {
        return /databases/$(database)/documents/users/$(request.auth.uid);
      }

      // Read from the protected users/{uid}, never from token claims. A student without a
      // profile yet, or whose profile has no accountType, is not an association.
      function isAssociationAccount() {
        return exists(callerProfile())
            && get(callerProfile()).data.get('accountType', null) == 'association';
      }

      function isVerifiedAssociation() {
        return isAssociationAccount()
            && get(callerProfile()).data.get('isAssociationVerified', false) == true;
      }

      // Who may create and manage events: a student (isStudent, the same check as reads), or an
      // association a PolySocial admin has verified. An association account with an @epfl.ch
      // email still needs that verification.
      function canWriteEvents() {
        return hasVerifiedEmail() && (isVerifiedAssociation() || isStudent());
      }

      // The limits of validateNewEvent (title, description), MAX_LOCATION_NAME_LENGTH and the
      // EventCategory names. Events saved before locationName existed don't have it. The
      // creator always stays an organizer, and every organizer is an allowed reader, so no
      // organizer can manage a private event they can't read.
      function isValidEvent(data) {
        return data.title is string
            && data.title.trim().size() > 0
            && data.title.size() <= 80
            && data.description is string
            && data.description.size() <= 5000
            && (!('locationName' in data)
                || (data.locationName is string && data.locationName.size() <= 100))
            && data.category in ['STUDY', 'SPORTS', 'CULTURE', 'PARTY', 'OTHER']
            && data.isPrivate is bool
            && data.isAssociationEvent is bool
            && data.organizerIds is list
            && data.organizerIds.hasAny([data.createdBy])
            && data.allowedUids is list
            && data.allowedUids.hasAll(data.organizerIds);
      }

      function isOrganizer() {
        return resource.data.organizerIds.hasAny([request.auth.uid]);
      }

      // Only a verified association may publish under its name (the verified badge), and it
      // always does: it can read only its own association events, so an event without the
      // badge would be unreadable to its own creator.
      allow create: if canWriteEvents()
          && request.resource.data.createdBy == request.auth.uid
          && isValidEvent(request.resource.data)
          && request.resource.data.isAssociationEvent == isVerifiedAssociation();

      // Any organizer manages the event. The creator and the badge are fixed once created.
      allow update: if canWriteEvents()
          && isOrganizer()
          && isValidEvent(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['createdBy', 'isAssociationEvent']);

      allow delete: if canWriteEvents() && isOrganizer();

      // A student's registration for this event (#121), keyed by the student's UID, with that UID
      // again in `uid` (for the collection-group query below) and the server time in
      // `registeredAt`. A student registers only themselves, for an event they can read (the
      // same check as the event's read rule) that hasn't ended yet, and can always remove their
      // own registration, even once the event has ended, is deleted or is no longer readable.
      // The event's organizers read its registrations, to count its attendees. Nobody updates
      // one. The capacity isn't checked yet: that needs a team decision on how a student may
      // count attendees.
      match /attendees/{uid} {
        function event() {
          return /databases/$(database)/documents/events/$(eventId);
        }

        function isSelf() {
          return isStudent() && request.auth.uid == uid;
        }

        function canReadEvent() {
          return exists(event())
              && (get(event()).data.isPrivate == false
                  || (get(event()).data.isPrivate == true
                      && get(event()).data.allowedUids.hasAny([request.auth.uid])));
        }

        // Like Event.isPast in the app: an event has ended once its endTime has passed, or
        // its startTime when it has no endTime. An event with neither as a timestamp counts as
        // ended, since nobody can tell.
        function hasNotEnded() {
          let data = get(event()).data;
          let end = data.get('endTime', null) is timestamp
              ? data.endTime
              : data.get('startTime', null);
          return end is timestamp && request.time < end;
        }

        // A missing organizerIds (events written before #47) gives no organizer.
        function isEventOrganizer() {
          return canWriteEvents()
              && exists(event())
              && get(event()).data.get('organizerIds', []).hasAny([request.auth.uid]);
        }

        allow get: if isSelf() || isEventOrganizer();
        allow list: if isEventOrganizer();
        allow create: if isSelf()
            && canReadEvent()
            && hasNotEnded()
            && request.resource.data.keys().hasOnly(['uid', 'registeredAt'])
            && request.resource.data.uid == uid
            && request.resource.data.registeredAt == request.time;
        allow delete: if isSelf();
      }
    }

    // A student's own registrations across events (#121), for My events and "I'm going": the
    // collection-group query `attendees where uid == <their UID>`. Rules aren't filters, so a
    // query that doesn't constrain uid to the caller is denied.
    match /{path=**}/attendees/{uid} {
      allow list: if isStudent() && resource.data.uid == request.auth.uid;
    }

    // An event's groups (#228, built by #232), the second reachable event subcollection after
    // attendees: capacity (4, stored so it can change), memberUids (1 to capacity UIDs, the creator
    // first), createdBy and the server's createdAt. A student who can read the event (the same
    // check as the event's read rule) reads its groups, starts one, or joins one. A member also
    // reads their own group once they can no longer read the event, so they can still leave it.
    // Each write changes only the caller's own UID in memberUids, always together with their
    // groupMembers marker (below, checked with getAfter), which keeps a student in at most one
    // group per event. The capacity is checked here, so it needs no counter; the client's
    // transaction stops two students taking the last place. The last member to leave deletes the
    // group. Associations get no access (isStudent).
    match /events/{eventId}/groups/{groupId} {
      function event() {
        return /databases/$(database)/documents/events/$(eventId);
      }

      function ownMarker() {
        return /databases/$(database)/documents/events/$(eventId)/groupMembers/$(request.auth.uid);
      }

      function canReadEvent() {
        return exists(event())
            && (get(event()).data.isPrivate == false
                || (get(event()).data.isPrivate == true
                    && get(event()).data.allowedUids.hasAny([request.auth.uid])));
      }

      // After this write, the caller's marker names this group. A missing marker fails.
      function ownMarkerNamesThisGroupAfter() {
        return getAfter(ownMarker()).data.groupId == groupId;
      }

      // Joining appends the caller's UID, within the capacity, and creates their marker.
      function isJoining() {
        let before = resource.data.memberUids;
        let after = request.resource.data.memberUids;
        return canReadEvent()
            && !before.hasAny([request.auth.uid])
            && after == before.concat([request.auth.uid])
            && after.size() <= resource.data.capacity
            && !exists(ownMarker())
            && ownMarkerNamesThisGroupAfter();
      }

      // Leaving removes only the caller's UID, leaves someone in the group (the last member
      // deletes it instead), and deletes their marker.
      function isLeaving() {
        let before = resource.data.memberUids;
        let after = request.resource.data.memberUids;
        return before.hasAny([request.auth.uid])
            && after == before.removeAll([request.auth.uid])
            && after.size() > 0
            && !existsAfter(ownMarker());
      }

      allow list: if isStudent() && canReadEvent();
      // A member removed from a private event's allowedUids still gets their group, so they can
      // leave it. That shows them nothing new: they already list it through /{path=**}/groups.
      allow get: if isStudent()
          && (canReadEvent() || resource.data.memberUids.hasAny([request.auth.uid]));
      // exists() reads the marker as it was before this write: a student who already has one
      // can't start a group, whatever the marker rules allow.
      allow create: if isStudent()
          && canReadEvent()
          && request.resource.data.keys().hasOnly(['capacity', 'memberUids', 'createdBy', 'createdAt'])
          && request.resource.data.capacity == 4
          && request.resource.data.memberUids == [request.auth.uid]
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !exists(ownMarker())
          && ownMarkerNamesThisGroupAfter();
      allow update: if isStudent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && (isJoining() || isLeaving());
      allow delete: if isStudent()
          && resource.data.memberUids == [request.auth.uid]
          && !existsAfter(ownMarker());
    }

    // A student's own groups across events (#232): the collection-group query
    // `groups where memberUids array-contains <their UID>`. Rules aren't filters, so a query that
    // doesn't constrain memberUids to the caller is denied.
    match /{path=**}/groups/{groupId} {
      allow list: if isStudent() && resource.data.memberUids.hasAny([request.auth.uid]);
    }

    // A student's marker for an event's groups (#232), keyed by their UID: groupId names their
    // group for the event, so a transaction, which can't run a query, sees whether they are
    // already in one. Only that student reads, creates or deletes it, in the same write as their
    // memberUids change: a new marker names a group whose memberUids contain them after the write,
    // and it is deleted only once they are no longer in that group. Nobody updates one, so a
    // student can't switch groups without leaving the first. Associations get no access.
    match /events/{eventId}/groupMembers/{uid} {
      function isSelf() {
        return isStudent() && request.auth.uid == uid;
      }

      function group(id) {
        return /databases/$(database)/documents/events/$(eventId)/groups/$(id);
      }

      allow get: if isSelf();
      allow create: if isSelf()
          && request.resource.data.keys().hasOnly(['groupId'])
          && request.resource.data.groupId is string
          && request.resource.data.groupId.matches('[^/]+')
          && getAfter(group(request.resource.data.groupId)).data.memberUids.hasAny([uid]);
      allow delete: if isSelf()
          && !(existsAfter(group(resource.data.groupId))
              && getAfter(group(resource.data.groupId)).data.memberUids.hasAny([uid]));
    }

    // A group's chat (#237): each message has exactly senderId, text (1 to 1000 characters,
    // counted like the app's MAX_MESSAGE_LENGTH) and the server's createdAt. Only the group's
    // members read and send, each message as themselves; nobody edits or deletes one yet (report
    // and block come later). Membership is read from the group itself, as its own get rule does:
    // a member removed from a private event's allowedUids still reaches their group (#295), so
    // they keep its chat too. A deleted account can't send (isDeletedAccount): deleteAccount
    // leaves its UID in memberUids, and its ID token stays valid for up to an hour, so it could
    // otherwise still write new personal data after the deletion. Each operation has its own
    // rule, so a rate limit can be added to create without touching reads. Associations get no
    // access (isStudent).
    match /events/{eventId}/groups/{groupId}/messages/{messageId} {
      function isMember() {
        let group = /databases/$(database)/documents/events/$(eventId)/groups/$(groupId);
        return isStudent()
            && exists(group)
            && get(group).data.memberUids.hasAny([request.auth.uid]);
      }

      allow get, list: if isMember();
      allow create: if isMember()
          && !isDeletedAccount(request.auth.uid)
          && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
    }

    // An association's public profile (#126), keyed by the association account's UID. Its
    // owner, an account whose users/{uid} is an association's, reads and writes it from sign-up
    // on, before an admin has verified it, so it can set it up while its review is pending.
    // Besides its own users/{uid}, that is the only exception to "no access before
    // verification". Students read it only once an admin has verified the association
    // (users/{uid}.isAssociationVerified, read here with get(), so students never see
    // users/{uid} itself); other associations never do. Once verified, its name and type are
    // fixed, so a verified badge can't move to another name. Nobody lists the collection, and
    // only an admin deletes a document.
    match /associations/{uid} {
      function isAssociationOwner() {
        let profile = /databases/$(database)/documents/users/$(request.auth.uid);
        return hasVerifiedEmail()
            && request.auth.uid == uid
            && exists(profile)
            && get(profile).data.get('accountType', null) == 'association';
      }

      function isVerifiedAssociation() {
        let owner = /databases/$(database)/documents/users/$(uid);
        return exists(owner)
            && get(owner).data.get('accountType', null) == 'association'
            && get(owner).data.get('isAssociationVerified', false) == true;
      }

      // The fields of the Figma "Association setup" frame, with the app's limits, and nothing
      // else: no email, no verification flag. A missing name, type or about fails its check
      // below, and a missing createdAt fails request.time on create and is a change on update.
      function isValidAssociation(data) {
        return data.keys().hasOnly(['name', 'type', 'about', 'website', 'createdAt'])
            && data.name is string
            && data.name.trim().size() > 0
            && data.name.size() <= 60
            && data.type in ['ASSOCIATION', 'COMMISSION', 'CLUB', 'EPFL_UNIT']
            && data.about is string
            && data.about.trim().size() > 0
            && data.about.size() <= 1000
            && (!('website' in data)
                || (data.website is string
                    && data.website.size() <= 200
                    && data.website.matches('https://[^\\s]+')));
      }

      allow get: if isAssociationOwner() || (isStudent() && isVerifiedAssociation());

      allow create: if isAssociationOwner()
          && isValidAssociation(request.resource.data)
          && request.resource.data.createdAt == request.time;

      allow update: if isAssociationOwner()
          && isValidAssociation(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
          && !(isVerifiedAssociation()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['name', 'type']));
    }
  }
}
