// Contributors: Claude (isEpflUser helper, #33).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified @epfl.ch email address.
    function isEpflUser() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.matches('[^@]+@epfl[.]ch');
    }

    match /{document=**} {
      allow read, write: if isEpflUser();
    }
  }
}
