<?xml version="1.0" encoding="utf-8"?>
<!-- Contributors: Claude (cleartext to the Firebase emulators in debug builds only, #117). -->
<network-security-config>
    <!-- Replaces the HTTPS-only file in src/main for debug builds.
         10.0.2.2 is the host machine seen from an Android emulator, where the Firebase emulators
         run without TLS. Every other address keeps the default: HTTPS only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
