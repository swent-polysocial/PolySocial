<?xml version="1.0" encoding="utf-8"?>
<!-- Contributors: Claude (registered the Hilt application class, #70; network state permission for the online check; network security config that debug builds override, #117); OpenAI Codex (GPT-6.1 Sol Medium; removed activity labels to inherit the PolySocial app name; enabled keyboard resizing for the auth forms; foreground location permissions, #51); Claude (Opus 5.5, Anthropic; turned off messaging auto-init, #206) and Mohamed Khellaf (reviewed and revised). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets NetworkMonitor check whether the device is online before writing to Firestore. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".PolySocialApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PolySocial"
        tools:targetApi="31">
        <activity
            android:name=".SecondActivity"
            android:exported="false"
            android:theme="@style/Theme.PolySocial" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PolySocial">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- firebase-functions pulls in firebase-iid, which would otherwise register an
             Installation ID and messaging token at every app start although the app sends no
             notifications. With auto-init off, the token is only fetched when the deleteAccount
             callable runs (#206). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>

</manifest>
