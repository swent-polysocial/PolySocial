        <item quantity="one">%1$s (+%2$d day)</item>
        <item quantity="other">%1$s (+%2$d days)</item>
    </plurals>
    <!-- Shown instead of the place's name for events saved before the name was stored. -->
    <string name="event_detail_unnamed_location">Place on the map</string>
