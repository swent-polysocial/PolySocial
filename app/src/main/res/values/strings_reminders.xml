<?xml version="1.0" encoding="utf-8"?>
<!-- Contributors: Claude Opus 5.5 (reminder notification texts from the Figma frame "Reminder · system notification", #123; time left after review; the toggle, its permission explanation sheet and the notifications-blocked note, from Figma "Event detail · registered" 558:2, "Reminder · permission explanation" 558:119 and "Reminder · notifications denied" 558:186, second PR). -->
<resources>
    <!-- Name of the notification channel, shown in Android's notification settings. -->
    <string name="reminder_channel_name">Event reminders</string>
    <!-- Notification title, for example "Balélec warm-up starts in 1 h". -->
    <string name="reminder_title_hours">%1$s starts in %2$d h</string>
    <!-- Notification title when the reminder runs late, for example "Balélec warm-up starts in 10 min". -->
    <string name="reminder_title_minutes">%1$s starts in %2$d min</string>
    <!-- Day and start time, for example "Today 20:00". -->
    <string name="reminder_when">%1$s %2$s</string>
    <!-- Day, start time and place, for example "Today 20:00 · Satellite, EPFL". -->
    <string name="reminder_when_where">%1$s %2$s · %3$s</string>
    <!-- The event detail toggle's title. -->
    <string name="reminder_toggle_title">Remind me 1 h before</string>
    <!-- Toggle subtitle while notifications aren't known to be blocked. -->
    <string name="reminder_toggle_subtitle">Works offline · asks for notification permission once</string>
    <!-- Toggle subtitle once notifications are blocked for the app. -->
    <string name="reminder_toggle_subtitle_blocked">Off: notifications are blocked for PolySocial</string>
    <!-- Permission explanation sheet, shown before Android's own prompt. -->
    <string name="reminder_explanation_title">Get a reminder before events</string>
    <string name="reminder_explanation_body">PolySocial sends a notification 1 h before each event you turn reminders on for. Android asks for permission next; you can change it anytime in Settings.</string>
    <string name="reminder_explanation_continue">Continue</string>
    <string name="reminder_explanation_not_now">Not now</string>
    <!-- Note shown once notifications are blocked, with a link to the app's settings. -->
    <string name="reminder_denied_note">Turn on notifications to get reminders.</string>
    <string name="reminder_open_settings">Open settings</string>
</resources>
